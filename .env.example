# Copy this file to ".env" and adjust. ".env" is git-ignored; never commit real credentials.

# "local" enables developer conveniences (visible errors, layout preview, setup details).
# Use "production" for any deployed environment.
APP_ENV=local

# URL path prefix where public/ is served.
#  - Virtual host with DocumentRoot = .../public  ->  leave empty
#  - XAMPP htdocs without a virtual host          ->  /barangay-complaint-system/public
APP_BASE_PATH=/barangay-complaint-system/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=barangay_complaints
# XAMPP's default "root" with an empty password is for LOCAL DEVELOPMENT ONLY.
# Production must use a least-privilege database account (ARCHITECTURE §10).
DB_USER=root
DB_PASS=
